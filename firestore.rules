rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to check ownership of resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper to check super admin status
    function isSuperAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         request.auth.token.email in ['admin@amaltracker.com', 'superadmin@amaltracker.com']);
    }
    
    // User profile document
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isOwner(userId) || isSuperAdmin();
      
      // Personal Prayer Records
      match /prayers/{prayerId} {
        allow read: if isOwner(userId) || 
          (isSuperAdmin() && get(/databases/$(database)/documents/users/$(userId)).data.consentScope in ['DETAILED', 'AGGREGATE_ONLY']);
        allow write: if isOwner(userId);
      }
      
      // Tahajjud Records
      match /tahajjud/{tahajjudId} {
        allow read: if isOwner(userId) || 
          (isSuperAdmin() && get(/databases/$(database)/documents/users/$(userId)).data.consentScope in ['DETAILED', 'AGGREGATE_ONLY']);
        allow write: if isOwner(userId);
      }
      
      // Extended Amal Entries (Quran, Sadaqah, Adhkar)
      match /amalEntries/{amalId} {
        allow read: if isOwner(userId) || 
          (isAuthenticated() && resource.data.isSharedWithSquad == true) ||
          (isSuperAdmin() && get(/databases/$(database)/documents/users/$(userId)).data.consentScope == 'DETAILED');
        allow write: if isOwner(userId);
      }
      
      // Dhikr Sessions
      match /dhikr/{dhikrId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if isOwner(userId);
      }
    }
    
    // Squads collection
    match /squads/{squadId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || 
        isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || 
        isSuperAdmin()
      );
      
      // Squad Members subcollection
      match /members/{memberUid} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && (
          request.auth.uid == memberUid || 
          get(/databases/$(database)/documents/squads/$(squadId)).data.ownerUid == request.auth.uid ||
          isSuperAdmin()
        );
        allow delete: if isAuthenticated() && (
          request.auth.uid == memberUid || 
          get(/databases/$(database)/documents/squads/$(squadId)).data.ownerUid == request.auth.uid ||
          isSuperAdmin()
        );
      }
      
      // Squad Daily Aggregates (Privacy Preserving)
      match /aggregates/{date} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }
    
    // Admin Audit Logs (Write-only for events, readable only by Super Admins)
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }
  }
}
